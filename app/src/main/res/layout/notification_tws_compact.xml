<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:gravity="start|center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/compact_left_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/compact_left_bolt"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="1dp"
                android:contentDescription="@string/label_charging"
                android:src="@drawable/ic_bolt"
                android:visibility="gone" />

            <TextView
                android:id="@+id/compact_left_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Л: 100%"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compact_right_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/compact_right_bolt"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="1dp"
                android:contentDescription="@string/label_charging"
                android:src="@drawable/ic_bolt"
                android:visibility="gone" />

            <TextView
                android:id="@+id/compact_right_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="П: 100%"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/compact_case_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/compact_case_bolt"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="1dp"
                android:contentDescription="@string/label_charging"
                android:src="@drawable/ic_bolt"
                android:visibility="gone" />

            <TextView
                android:id="@+id/compact_case_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="К: 100%"
                android:textColor="#F8FAFC"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
