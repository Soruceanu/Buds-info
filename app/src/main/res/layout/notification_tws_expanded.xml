<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start|center_vertical"
    android:orientation="horizontal"
    android:paddingStart="52dp"
    android:paddingTop="4dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/expanded_left_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/left_charging_bolt"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="1dp"
            android:contentDescription="@string/label_charging"
            android:src="@drawable/ic_bolt"
            android:visibility="gone" />

        <TextView
            android:id="@+id/expanded_left_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Л: 100%"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expanded_right_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/right_charging_bolt"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="1dp"
            android:contentDescription="@string/label_charging"
            android:src="@drawable/ic_bolt"
            android:visibility="gone" />

        <TextView
            android:id="@+id/expanded_right_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="П: 100%"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/expanded_case_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/case_charging_bolt"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="1dp"
            android:contentDescription="@string/label_charging"
            android:src="@drawable/ic_bolt"
            android:visibility="gone" />

        <TextView
            android:id="@+id/expanded_case_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="К: 100%"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
